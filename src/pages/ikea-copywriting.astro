---
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseNavigation from "../components/CaseNavigation.astro";
import MetaLine from "../components/MetaLine.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";

const objects = [
  ["plane-field.png", "Картонный самолёт"],
  ["shark-field.png", "Фотостенд с картонной акулой"],
  ["town-field.png", "Картонный город"],
];

const manuals: Array<[string, string, number]> = [
  ["manual-overview.png", "Выкройка всех деталей картонного самолёта", 1160],
  ["manual-steps-12.png", "Шаги 1–2: сборка корпуса", 1112],
  ["manual-steps-34.png", "Шаги 3–4: колёса и винт", 1066],
  ["manual-steps-56.png", "Шаги 5–6: крылья, хвост и финальная сборка", 1064],
];
---

<BaseLayout title="IKEA · Коробка, которая мечтала летать · Andrei Arnautov">
  <article class="case" id="ikea-copywriting">
    <h1><MetaLine parts={["IKEA", "Коробка, которая мечтала летать"]} /></h1>

    <section class="ikea-second-life" aria-label="Ключевой визуал и идеи из картона">
      <ResponsiveImage
        base="/media/_optimized/ikea-copywriting/second-life-key-visual-trimmed"
        sizes="(max-width: 900px) calc(100vw - 36px), 368px"
        alt="Ключевой визуал IKEA «Коробка, которая мечтала летать»"
        loading="eager"
        fetchpriority="high"
      />
      <div class="ikea-object-column">
        {objects.map(([src, alt]) => (
          <ResponsiveImage
            base={`/media/_optimized/ikea-copywriting/${src.replace(".png", "")}`}
            widths={src === "plane-field.png" ? [480, 800] : src === "shark-field.png" ? [384] : [568]}
            sizes="(max-width: 900px) calc((100vw - 104px) / 3), 372px"
            alt={alt}
          />
        ))}
      </div>
    </section>

    <section class="story-grid" aria-label="Описание кейса">
      <p>
        Что делать с картонными коробками после доставки? Мы с IKEA подошли к
        проблеме творчески.
      </p>
      <p>
        И собрали инструкции для семейных поделок из картона на основе идей от
        участников IKEA Family.
      </p>
    </section>

    <section class="ikea-manual-grid" aria-label="Инструкция картонного самолёта">
      {manuals.map(([src, alt, width]) => (
        <ResponsiveImage
          base={`/media/_optimized/ikea-copywriting/${src.replace(".png", "")}`}
          widths={[640, Number(width)]}
          sizes="(max-width: 900px) calc(100vw - 36px), 188px"
          alt={alt}
        />
      ))}
    </section>

    <CaseNavigation
      previous={{ href: "/wink-80s", label: "предыдущая работа" }}
      next={{ href: "/beeline", label: "следующая работа" }}
    />
  </article>
</BaseLayout>
